# ── LOCAL DEVELOPMENT ─────────────────────────────────────────────
# Backend FastAPI server running locally
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Path to loan-perf-engine on your machine (local dev + docker-compose only)
ENGINE_ROOT=C:/Users/susan/OneDrive/Desktop/Intain/loan-perf-engine
INTAIN_PROJECT_ROOT=C:\Users\susan\OneDrive\Desktop\Intain\loan-perf-engine

# ── LLM / COPILOT ─────────────────────────────────────────────────
# Gemini via OpenAI-compatible API (default), or swap for OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# ── PRODUCTION ────────────────────────────────────────────────────
# Set on Vercel: NEXT_PUBLIC_API_URL=https://intain-api.onrender.com
# Set on Render: OPENAI_API_KEY=<your key>
