# Engine project root path for local development
# Points to the engine directory relative to backend
INTAIN_PROJECT_ROOT=../engine

# Set GROQ_API_KEY to use Groq, or OPENAI_API_KEY for OpenAI-compatible providers.
# Groq takes precedence when both keys are set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI-compatible provider key (optional; copilot returns an error if neither key is set)
OPENAI_API_KEY=
OPENAI_MODEL=gemini-3.8-flash
